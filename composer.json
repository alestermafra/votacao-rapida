{
    "name": "uspdev/votacao",
    "description": "Aplicação para realizar votações eletrônicas em reuniões",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Masaki Kawabata Neto",
            "email": "kawabata@usp.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "uspdev/webservice": "1.*",
        "uspdev/senhaunica": "^2.0",
        "flightphp/core": "^3.0",
        "gabordemooij/redbean": "^5.4",
        "raelgc/template": "^2.2",
        "vlucas/phpdotenv": "^4.1",
        "spipu/html2pdf": "^5.2",
        "oomphinc/composer-installers-extender": "^2.0",
        "phpmailer/phpmailer": "^6.1",
        "monolog/monolog": "2.*",
        "npm-asset/jquery": "3.5.*",
        "npm-asset/fortawesome--fontawesome-free": "^5.15",
        "bower-asset/bootstrap4": "4.5.*",
        "npm-asset/bootstrap-table": "^1.16",
        "league/commonmark": "^1.4",
        "league/oauth2-google": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "provide": {
        "mikecao/flight": "1.3.99"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "oomphinc/composer-installers-extender": true,
            "composer/installers": true
        },
        "policy": {
            "advisories": {
                "ignore": [
                    "league/commonmark"
                ]
            }
        }
    },
    "extra": {
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "public/assets/font-awesome/": [
                "npm-asset/fortawesome--fontawesome-free"
            ],
            "public/assets/{$name}/": [
                "type:bower-asset",
                "type:npm-asset"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Uspdev\\Votacao\\": "src"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}