# Configurações para uspdev/votacao

# dev ou prod
AMBIENTE='dev'

# URL onde está instalado a aplicação
WWWROOT='http://localhost:8000'
WWWROOT_API='http://localhost'

# Número usp do primeiro usuário admin
ADMIN_CODPES=99999999

# Se o servidor estiver atrás de um proxy ou firewall 
# cadastre no /etc/hosts o dominio 
# ex.: 127.0.0.1 votacaorapida.dominio.br

# sqlite ou outro
DB_TIPO='mysql'

# Se utilizar outro DB, deve preencher o DSN, username e password
DB_DSN='mysql:host=votacao-rapida-mysql;dbname=votacao'
DB_DATABASE='votacao'
DB_USERNAME='localuser'
DB_PASSWORD='localpassword'

# Senha unica
# github.com/uspdev/senhaunica
# callback de retorno: http://servidor/pasta_raiz/login
CONSUMER_KEY=''
CONSUMER_SECRET=''
SENHA_UNICA_CALLBACK_ID=''
SENHA_UNICA_AMB='' # prod ou dev

# Como a api está junto, vai criar esse usuário e usar ele para a comunicação
API_USER='admin'
API_PWD='admin'

# Servidor de Email
EMAIL_HOST='votacao-rapida-mailpit'
EMAIL_PORT=1025
EMAIL_AUTH_TYPE=null
EMAIL_FROM='from@example.com'
EMAIL_USERNAME=
EMAIL_PWD=

# Caso EMAIL_AUTH_TYPE=oauth, é necessário configurar as credenciais
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_REFRESH_TOKEN=